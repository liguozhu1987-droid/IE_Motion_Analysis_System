{
  "name": "ie-platform-api",
  "version": "1.0.0",
  "private": true,
  "description": "IE改善平台 · 目标架构（NestJS + TypeORM + SQL Server/SQLite 双数据源）",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "seed": "node dist/scripts/seed.js",
    "seed:demo": "node dist/scripts/seed-demo.js",
    "smoke": "node dist/test/smoke.js",
    "test:smoke:isolated": "node test/isolated-run.cjs smoke",
    "test:isolated": "node test/isolated-run.cjs && node test/sso-oidc-isolated.cjs",
    "test:sso:isolated": "node test/sso-oidc-isolated.cjs",
    "migrate:prod": "node dist/scripts/migrate.js",
    "ops:startup-check": "node dist/scripts/startup-check.js",
    "audit:retention": "node dist/scripts/audit-retention.js",
    "audit:retention:apply": "node dist/scripts/audit-retention.js --apply",
    "test:integration": "node test/frontend-integration.js",
    "test:change-pwd": "node test/change-pwd-flow.js",
    "test:auth-management": "node test/auth-management-flow.js",
    "test:baseline": "node test/perf-security-baseline.mjs",
    "test:security:isolated": "node test/security-isolated.cjs",
    "test:permission-matrix": "node test/permission-matrix.cjs",
    "test:xss:isolated": "node test/xss-browser.cjs",
    "test:deps": "node test/dependency-audit.mjs",
    "test:performance:isolated": "node test/performance-isolated.cjs",
    "test:ai-usage:isolated": "node test/ai-usage-isolated.cjs --browser"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "mssql": "^11.0.1",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.2"
  }
}
