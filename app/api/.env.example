# ===== IE 改善平台 API 配置模板 =====
# 用法：复制为 .env 后按环境填写；.env 已在 .gitignore 忽略。
# 生产必填：JWT_ACCESS_SECRET / JWT_REFRESH_SECRET（node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）

# —— 运行时 ——
NODE_ENV=production
PORT=3001
ORIGIN=http://localhost:5173

# —— 数据库：sqlite（开发演示，零依赖）/ mssql（SQL Server 生产）——
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=CN_AME
DB_USER=sa
DB_PASS=在此填写数据库口令
DB_ENCRYPT=false
# 连接池上限：50 人同时在线口径（稳态并发查询约 10~15，留一倍余量；SQL Server 默认上限 100）
DB_POOL_MAX=30
# DB_TYPE=sqlite 时生效：
# DB_PATH=./data/ie.db

# —— JWT ——
JWT_ACCESS_SECRET=在此填写32字节随机hex
JWT_REFRESH_SECRET=在此填写另一串32字节随机hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# —— 登录锁定 ——
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MIN=15

# —— 统一身份认证（OIDC 双轨，默认关闭）——
# 关闭时行为与改造前完全一致：仅本地账号登录。
# 开启后 Keycloak 登录成功仍签发本系统原有 JWT/refresh，下游鉴权零改动。
# 生产开启前必须把下面四项配齐；client secret 由部署环境注入，切勿写入仓库。
AUTH_OIDC_ENABLED=false
# 本地账号登录入口（D5：双轨期允许；单轨切换后可置 false，异常时改回 true 重启即可回退）
AUTH_LOCAL_LOGIN_ENABLED=true
# 自助注册（D9：能力保留、默认关闭）
AUTH_REGISTRATION_ENABLED=false
# Keycloak realm 地址（示例：https://sso.ap.inalfa.local/realms/inalfa）
AUTH_OIDC_ISSUER=
# Keycloak confidential client（D8：ie-platform）
AUTH_OIDC_CLIENT_ID=ie-platform
# 仅部署环境注入；不要写进本文件/仓库
AUTH_OIDC_CLIENT_SECRET=
# 必须与 Keycloak client 的回调地址精确匹配（生产填固定内网地址）
# 留空 = 按请求 Host 推导 http(s)://<host>/api/auth/oidc/callback，仅适用于单机/隔离测试
AUTH_OIDC_REDIRECT_URI=
# 准入组（D8：app-ie）；前导 '/' 自动兼容
AUTH_OIDC_REQUIRED_GROUP=app-ie
# 五表映射的系统编码（D1：ie），对应 CN_AME_SSO_UserMap.system_code
AUTH_OIDC_SYSTEM_CODE=ie
# 中央表有、本地无时的自动建档（D2 开）与默认角色（D3 viewer）
AUTH_OIDC_AUTO_PROVISION=true
AUTH_OIDC_DEFAULT_ROLE=viewer
# 前端回调页（hash 路由）；改动需同步前端
AUTH_OIDC_FRONTEND_CALLBACK=#/oidc/callback
# discovery/JWKS/令牌交换超时（毫秒）
AUTH_OIDC_TIMEOUT_MS=5000

# —— 登录失败双桶限流（只计失败；成功登录清零账号桶，正常用户零消耗）——
# IP 桶：同一出口 IP 的失败总数（防批量试错）
LOGIN_IP_MAX_FAIL=15
LOGIN_IP_WINDOW_MIN=5
# 账号桶：同一用户名的失败总数（防定点爆破）；同时受上面的 DB 锁定策略约束
LOGIN_USER_MAX_FAIL=10
LOGIN_USER_WINDOW_MIN=15

# —— 安全 / 反向代理 ——
# 客户端 IP 专用头：IIS ARR 的 URL Rewrite 必须用 {REMOTE_ADDR} **覆写**该头（不是 append）
CLIENT_IP_HEADER=x-real-ip
# 可信反代 socket peer 白名单：只有来自这些地址的请求，专用头才被采信
TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
# HSTS：NODE_ENV=production 时自动开启；纯 HTTP 内网请留空（下发 HSTS 会让站点打不开）
SEC_HSTS=on
# /metrics 抓取令牌：Prometheus 侧用 authorization: Bearer <token> 或 x-metrics-token
# 生成方式：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 留空时：生产一律 403（fail closed），非生产放行（仅本地调试）
METRICS_TOKEN=

# —— 驾驶舱聚合缓存 ——
# 0 = 关闭。30s 兜住"先后到达"的同条件请求，single-flight 兜住"同时到达"的请求
DASHBOARD_CACHE_TTL_MS=30000

# —— AI ——
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8000/v1
AI_KEY=na
AI_MODEL=qwen2.5-14b
AI_MONTHLY_TOKEN_LIMIT=200000
AI_TIMEOUT_MS=30000

# —— 视频 / 派生容量护栏（P0-1）——
# 下列推荐值基于目标机实测：6 核 Xeon E7-4850 v4 @2.10GHz / 32G 内存 / 磁盘空闲 150G，
# 同机另跑 NestJS + SQL Server + IIS ARR；实测机为 4C/8T i5-8265U（更慢，取值偏保守）。
# 调整依据与实测原始数据见 docs/ops/VIDEO-CAPACITY.md。
# 上传上限 MB（IIS 侧另需 maxAllowedContentLength > 该值；超限走分片绕过 413）
VIDEO_MAX_MB=2048
# 上传转码兜底：最长分钟数 / 最长边 / 目标帧率
VIDEO_MAX_MIN=180
VIDEO_MAX_WIDTH=1280
VIDEO_MAX_FPS=30
# 上传后是否自动入队派生（0=关；工作台载入时的 POST /derive 兜底仍有效）
VIDEO_AUTO_DERIVE=1
# derived/ 目录上限（GB）。推荐 60：150G 空闲里给系统/SQL 留 20G、源视频留 50G，
# 剩余 80G × 0.8 安全系数 ≈ 64G，取整 60G。按实测 25.6MB/分钟，60G ≈ 40 小时派生视频。
# 删除本行或留空/非法 = 磁盘治理关闭（启动期 warn，/api/videos/storage 回显 max_gb_configured=false）
# 上线部署时按目标机「实际可用磁盘」重算（不要硬套模板值）：可用空间 × 50% 向下取整到 10 的倍数
VIDEO_DERIVED_MAX_GB=60
# 转码并发数。推荐 2：实测 8 线程机上并发 2 时 CPU 均值 90.5%，并发 3 时 99.3%
# 且单任务耗时从 46.7s 劣化到 85.8s；目标机 12 线程下 2 并发可给 API/SQL 留 3~4 线程。
# 留空默认 2 并启动期提示确认
VIDEO_DERIVE_CONCURRENCY=2
# 单任务 ffmpeg 超时分钟。推荐 30：实测 10 分钟 720p 代理 29.1s，按并发 2 放大 ~2 倍
# 推算 30 分钟视频 < 5 分钟；30 分钟阈值留 6 倍以上余量，也能覆盖 180 分钟上传上限的极端情况。
# 留空默认 30
VIDEO_DERIVE_TIMEOUT_MIN=30
# running 行无更新判定超时分钟（进程崩溃后回置 pending）。推荐 35，须大于上面的单任务超时，
# 否则健康的长任务可能被误判回收并重复跑。留空默认 30
VIDEO_RUNNING_STALE_MIN=35
# 磁盘治理 du 周期秒（最小 10，默认 60）
VIDEO_DERIVED_DU_SEC=60
# 孤儿派生行巡检：1=开（源视频被人工删除后清派生行与输出目录）；默认关（防共享存储瞬时不可见误删）
VIDEO_ORPHAN_SWEEP=0

# —— 源视频保留与到期提醒（2026-11-06 用户决策；未配置=默认 10/3 并启动期 warn「待现场确认」）——
# 默认保留天数；到期前 notice 天发邮件提醒，上传者/管理员可选择「再保留」或「永久保留」，
# 到期仍未选择 → 自动硬删源文件 + 派生文件（不做回收站，写审计）。
VIDEO_RETENTION_DAYS=10
VIDEO_RETENTION_NOTICE_DAYS=3
# 通知失败后的重试冷却小时（成功通知只发一次，不重复轰炸）
VIDEO_RETENTION_NOTIFY_RETRY_HOURS=24

# —— 其他 ——
LOG_LEVEL=info
LOG_DIR=./logs
RULES_DIR=../config/rules
SEED=true

# —— 运维任务（P0-3；默认不自动执行，由人工或任务计划显式调用）——
# 审计记录保留天数（默认 730 = 2 年）；清理脚本默认干跑，--apply 才删除
AUDIT_RETENTION_DAYS=730
# 应用日志文件保留天数（默认同审计）
LOG_RETENTION_DAYS=730
# 审计批删大小（每批删除行数，避免长事务锁表）
AUDIT_RETENTION_BATCH=5000

# —— AI 改善建议模块 ——
# 总开关：false=全部端点 403/503（默认关；独立于 AI_ENABLED，不影响既有润色降级）
AI_SUGGEST_ENABLED=false
# LLM 端点（OpenAI 兼容 /chat/completions）；端点不可达时明确报错宁缺勿错
AI_LLM_BASE_URL=http://127.0.0.1:8000/v1
AI_LLM_API_KEY=na
AI_LLM_MODEL=qwen2.5-14b
# 批次节省上界系数：Σest_save_s > 系数×CT → 转人工标记（不剔除）；行业单轮通常 10%~30%
AI_BATCH_CEILING=0.5
# 配额槽位维度：station=同工位同用户一个成功槽位（默认）；station+version=复测后可再生成
AI_QUOTA_SCOPE=station

# —— 告警监控（日志告警默认开启，零成本；SMTP 不配 = 只落日志不发信）——
# 检查周期秒（最小 10）
ALERT_CHECK_SEC=60
# 登录锁定账号数阈值（当前锁定 ≥ 此值告警）
ALERT_LOGIN_LOCKED_MAX=5
# AI 任务 pending 堆积阈值（> 此值告警）
ALERT_AI_TASK_BACKLOG=50
# HTTP 5xx 错误率阈值 %（按检查窗口增量计）
ALERT_ERROR_RATE_PCT=1
# 错误率最小样本（窗口请求 < 此值不判定，防零星 5xx 拉爆）
ALERT_ERROR_MIN_REQUESTS=20
# 同一规则两次告警最小间隔分钟（边沿触发+冷却防刷屏）
ALERT_COOLDOWN_MIN=30

# —— 业务告警阈值（P0-4；未配置 = 规则关闭，启动期显式 warn，不暗设默认）——
# 派生失败率阈值 %：窗口内终端派生（ready / error retry>=2）失败占比 ≥ 此值告警
ALERT_DERIVE_FAIL_PCT=
# AI 任务失败率阈值 %：窗口内终态任务（done / failed）失败占比 ≥ 此值告警
ALERT_AI_FAIL_PCT=
# 上述两条失败率的统计窗口（分钟）与最小样本（窗口样本不足不判定，防小样本误报）
# 这两项与两条失败率阈值必须同时配置，否则两条失败率规则整体关闭
ALERT_FAIL_WINDOW_MIN=
ALERT_FAIL_MIN_SAMPLE=
# 派生磁盘占用规则复用 P0-1 的 VIDEO_DERIVED_MAX_GB（未配置 = 规则关闭，worker 也不 du/不淘汰）

# —— SMTP（可选：HOST 与 ALERT_MAIL_TO 都非空才发邮件）——
# 生产内网中继推荐值（无认证：SMTP_USER / SMTP_PASS 留空）
SMTP_HOST=172.19.253.10
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
# 内网中继要求有效发件人时填写；留空且无 SMTP_USER 时启动期会 warn
SMTP_FROM=
# 多个收件人逗号分隔；留空 = 只落日志不发信
ALERT_MAIL_TO=
# 内网自签 SMTP 证书默认放宽；true=严格校验
SMTP_TLS_REJECT_UNAUTHORIZED=
