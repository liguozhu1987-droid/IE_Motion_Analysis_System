# ===== IE 改善平台 · 单文件部署版配置（随发布包分发，改完必须重启生效）=====
# 本文件位于 exe 同级目录；程序启动时会自动切换到 exe 所在目录再读取本文件，
# 因此无论从桌面双击、命令行还是 Windows 服务启动，配置路径都一致。
# 生产部署请务必修改：JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / DB_PASS / METRICS_TOKEN

# —— 运行时 ——
NODE_ENV=production
PORT=3001
# 监听地址：单文件版无反代直曝需 0.0.0.0；若前置 IIS/nginx 反代，改回 127.0.0.1
HOST=0.0.0.0
# 同源部署（前端由本程序托管）无需关心 ORIGIN；仅当另开域名/端口直调 API 时才需要
ORIGIN=http://localhost:5173

# —— 数据库：SQL Server（生产；目标机需先装 SQL Server 并执行 migrate）——
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=CN_AME
DB_USER=sa
DB_PASS=<由部署环境注入>
DB_ENCRYPT=false
DB_POOL_MAX=30

# —— JWT（生产 fail-fast 强制；勿使用 dev- 前缀占位）——
JWT_ACCESS_SECRET=<部署时生成：32 字节随机 hex>
JWT_REFRESH_SECRET=<部署时生成：32 字节随机 hex>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# —— 登录锁定 ——
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MIN=15

# —— AI（内网 vLLM / OpenAI 兼容网关；关闭时润色接口返回 503 降级）——
AI_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8000/v1
AI_KEY=na
AI_MODEL=qwen2.5-14b
AI_MONTHLY_TOKEN_LIMIT=200000
AI_TIMEOUT_MS=30000

# —— 其他 ——
LOG_LEVEL=info
LOG_DIR=./logs
# 规则文件目录：随包 config/rules/（benefit_params.json 在同级 config/ 下，程序自动解析）
RULES_DIR=./config/rules
# 空库自动灌入演示数据（用户/角色/工位）；接存量库或正式上线后置 0
SEED=true
# 前端静态目录（默认 ./web/dist，删除此行同样生效）；不需要托管前端时设为不存在的路径即可
#WEB_DIST=./web/dist
# ffmpeg 可执行（默认 ./bin/ffmpeg.exe，删此行同样生效）；系统 PATH 里有 ffmpeg 时可不随包分发
#FFMPEG_BIN=./bin/ffmpeg.exe

# —— 安全 / 反向代理（v3.4 并发50人加固）——
# 客户端 IP 信任链：ARR 与 API 同机，socket peer 恒为回环，只能靠 ARR 覆写的专用头
CLIENT_IP_HEADER=x-real-ip
TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
# HSTS：生产由 NODE_ENV=production 自动开启；内网纯 HTTP 环境请留空
SEC_HSTS=on
# /metrics 抓取令牌（Prometheus 用 authorization: Bearer <token> 或 x-metrics-token）
METRICS_TOKEN=<部署时生成：32 字节随机 hex>

# —— 登录失败双桶限流（只计失败；成功登录清零账号桶）——
LOGIN_IP_MAX_FAIL=15
LOGIN_IP_WINDOW_MIN=5
LOGIN_USER_MAX_FAIL=10
LOGIN_USER_WINDOW_MIN=15

# —— 驾驶舱聚合缓存（0 = 关闭；30s 兜先后到达，single-flight 兜同时到达）——
DASHBOARD_CACHE_TTL_MS=30000

# —— AI 改善建议模块（v3.30；AI_SUGGEST_ENABLED=false 默认关，与 AI_ENABLED 互不影响）——
AI_SUGGEST_ENABLED=false
# LLM 端点（OpenAI 兼容 /chat/completions；未配置时回落 AI_BASE_URL/AI_KEY/AI_MODEL）
AI_LLM_BASE_URL=http://127.0.0.1:8000/v1
AI_LLM_API_KEY=na
AI_LLM_MODEL=qwen2.5-14b
# 批次节省上界：Σest_save_s > 该系数×CT → risk_flags=exceeds_batch_ceiling（转人工不剔除）
AI_BATCH_CEILING=0.5
# 配额槽位维度：station（默认，同工位同用户仅一个成功槽位）| station+version（复测后可再生成）
AI_QUOTA_SCOPE=station
