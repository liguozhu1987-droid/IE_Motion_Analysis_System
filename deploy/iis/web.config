<?xml version="1.0" encoding="UTF-8"?>
<!--
  IE 改善平台 — IIS 站点根目录 web.config（P0-3）
  适用形态：IIS 托管前端静态文件（wwwroot = app/web/dist），/api 反代到同机 NestJS（127.0.0.1:3001）。

  ── 前置（服务器级，不在本文件里；需在 IIS 管理器或 applicationHost.config 配置）──
  1. 安装 URL Rewrite + Application Request Routing (ARR)，并在「服务器代理」启用 proxy；
  2. 允许本规则使用 X-Real-IP 服务器变量（否则命中规则会 500.19）：
       appcmd set config /section:rewrite /+allowedServerVariables.[name='HTTP_X_REAL_IP']
  3. ARR 关闭响应缓冲，避免视频拖动被整段缓冲（applicationHost.config）：
       <proxy enabled="true" preserveHostHeader="true" responseBufferLimit="0" />
  4. 大请求体（分片 8MB + multipart 开销）如仍报 413，在 applicationHost.config 调大：
       <serverRuntime uploadReadAheadSize="16777216" />

  ── 分片阈值对齐 ──
  前端 app/web/src/video/chunkedUpload.ts 的 CHUNK_BYTES = 8MB；>8MB 的文件一律分片上传。
  maxAllowedContentLength 取 16MB（8MB 分片 + multipart 边界/头部约 2 倍余量），
  单个 HTTP 请求永远不会接近 2GB 的 VIDEO_MAX_MB 上限（该上限由服务端 multer 兜底）。
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1) API 反代：/api/* → 同机 NestJS。timeout 覆盖 scene-detect 等长请求；
             登录/上传/流式下载都不应被 10 分钟截断。 -->
        <rule name="api-reverse-proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/api/{R:1}" timeout="00:10:00" />
          <serverVariables>
            <!-- 由 ARR 覆写为真实客户端 IP；API 侧 CLIENT_IP_HEADER 默认就是 x-real-ip -->
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
          </serverVariables>
        </rule>

        <!-- 2) SPA 回退：非 /api、非真实文件/目录 → index.html（React Router 刷新不 404） -->
        <rule name="spa-fallback" stopProcessing="true">
          <match url="^((?!api/).)*$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- 3) 请求体上限：与 8MB 分片阈值对齐（16MB） -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="16777216" />
      </requestFiltering>
    </security>

    <!-- 4) 静态资源缓存：Vite 产物 /assets/<hash> 内容寻址，可长缓存；入口 HTML 不缓存 -->
    <outboundRules>
      <rule name="hashed-assets-immutable" preCondition="isHashedAsset" stopProcessing="false">
        <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
        <action type="Rewrite" value="public, max-age=31536000, immutable" />
      </rule>
      <rule name="html-no-cache" preCondition="isHtmlEntry" stopProcessing="false">
        <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
        <action type="Rewrite" value="no-cache" />
      </rule>
      <preConditions>
        <preCondition name="isHashedAsset">
          <match input="{URL}" pattern="^/assets/.*" />
        </preCondition>
        <preCondition name="isHtmlEntry">
          <match input="{URL}" pattern="^/(index\.html)?$" />
        </preCondition>
      </preConditions>
    </outboundRules>

    <!-- 5) 去掉指纹头；MIME 嗅探关闭 -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <!-- 6) 默认文档 -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
