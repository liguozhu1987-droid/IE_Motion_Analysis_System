# 依赖与构建产物
node_modules/
dist/
build/
*.tsbuildinfo

# 日志与运行时
*.log
*.err.log
*.pid
nohup.out

# 临时与探测
.temp-probe/
probe_out.txt
app/api/.tools/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 会话产物（截图、临时下载）
app/web/shots/
*.tmp

# Office 锁文件
~$*
.workbuddy/tmp/

# 单文件发布包（195MB，走拷贝分发不进 git）
deliverables/IE-Platform-*/

# WorkBuddy 平台自动化内部数据（非项目产物）
.workbuddy/memory/automations/

# ffmpeg二进制程序（体积大，走拷贝分发，不入库）
app/api/bin/*.exe
# 视频文件
*.mp4

# 运行时上传与导出（storage 实测 156MB：视频/派生/留档 XLSX，不进版本历史；
# 目录由 API 运行时创建，0b 基线提交前必须忽略，否则 git add -A 会吞入大文件）
app/api/storage/

# esbuild 测试产物（test:desc-hints 每次生成）
app/web/*.built.cjs
app/web/*.built.cjs.map
